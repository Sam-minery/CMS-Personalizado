# Plantilla Landing-DROP / local
# Copia a .env y rellena valores: cp .env.example .env

# Postgres local (ajusta usuario/clave/nombre de DB)
DATABASE_URI=postgresql://USER:PASSWORD@localhost:5432/landing_drop
# Alternativa docker-compose.yml del repo:
# DATABASE_URI=postgresql://postgres:password@localhost:5432/payload_cms

# En local pueden ser simples; en producción usa valores largos y distintos
PAYLOAD_SECRET=secret1234
PREVIEW_SECRET=secret1234
CRON_SECRET=secret1234

# URL pública local — sin barra final
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

ENVIRONMENT=development

# --- Opcional: Google Cloud Storage (si no se definen, media va a disco local) ---
# GCS_BUCKET_NAME=
# GCS_PROJECT_ID=
# GCS_CLIENT_EMAIL=
# GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GCS_KEY_FILENAME=

# --- Opcional: leads (Sheets / Postmark / reCAPTCHA). Vacío = desactivado ---
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_TAB_LEADS=leads-formulario
# GOOGLE_SHEETS_CLIENT_EMAIL=
# GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# POSTMARK_SERVER_TOKEN=
# POSTMARK_FROM_EMAIL=
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_PROJECT_ID=
# RECAPTCHA_ENTERPRISE_API_KEY=
# RECAPTCHA_MIN_SCORE=

# Solo si conectas a Postgres remoto con SSL (no hace falta en localhost)
# DB_SSL_CA_PATH=./certs/certificado-DO.crt
